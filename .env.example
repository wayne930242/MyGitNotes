# Copy to .env at the application root. Start with pnpm dev.
# Import selected values to Vercel with pnpm env:vercel after linking the project.

# Data source: local, github or gitlab. Local paths resolve from the application root.
# The local path is the main worktree; pnpm bootstrap-workspace sets it (default ../<repo>-notes).
# Leave it empty only in a fork-model checkout whose root holds .mygitnotes.yaml.
MYGITNOTES_SOURCE=local
MYGITNOTES_LOCAL_PATH=
# Remote source: owner/repo (GitHub) or group/subgroup/project (GitLab).
MYGITNOTES_REPOSITORY=
MYGITNOTES_BRANCH=main

# Existing GITHUB_NOTES_* source settings remain supported.
# GitLab sign-in: configure an OAuth application on the selected HTTPS site.
# Callback: https://your-app.example/api/auth/gitlab/callback ; scope: api
MYGITNOTES_GITLAB_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# GitHub sign-in: these are the application's Client ID and Client Secret,
# not a personal access token. Register the callback below with GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# oauth-app uses the repo scope; github-app uses its configured permissions.
GITHUB_APP_TYPE=oauth-app
APP_URL=http://localhost:4321
# Production callback: https://your-app.example/api/auth/github/callback
# Generate SESSION_SECRET with: openssl rand -hex 32
SESSION_SECRET=

# Native Redis for self-hosting. Compose supplies its own Redis service.
# REDIS_URL takes precedence over Redis REST settings.
REDIS_URL=

# Redis REST sessions for Vercel. Encrypted tokens remain server-side.
# Create an Upstash Redis integration in the Vercel project's Storage section.
# Native integration KV_REST_API_URL / KV_REST_API_TOKEN are also supported.
# Self-hosting uses .github-notes-sessions/ if Redis is not configured.
# Persist that directory and SESSION_SECRET across container replacements.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Deployments sharing one Redis database each use a unique prefix; at most one leaves it empty.
# Set it before first login. Changing it later starts with no sessions or agent grants.
MYGITNOTES_SESSION_NAMESPACE=

# Optional: semantic commit messages for the local Git workflow.
GEMINI_API_KEY=
PORT=4321
# Docker sets HOST=0.0.0.0; direct Node.js startup defaults to loopback.
HOST=127.0.0.1
# Vite dev server port for `pnpm dev` / `pnpm dev:web`; default 5173.
MYGITNOTES_WEB_PORT=
