{
  "name": "mygitnotes-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap-workspace": "tsx scripts/bootstrap-workspace.ts",
    "update-core": "tsx scripts/update-core.ts",
    "build": "pnpm --filter \"@mygitnotes/*\" run build",
    "test": "node scripts/check-core-ownership.mjs && vitest run",
    "check:core-ownership": "node scripts/check-core-ownership.mjs",
    "dev": "pnpm --parallel --filter \"@mygitnotes/local-server\" --filter \"@mygitnotes/web\" dev",
    "dev:server": "pnpm --filter \"@mygitnotes/local-server\" dev",
    "dev:web": "pnpm --filter \"@mygitnotes/web\" dev",
    "env:vercel": "tsx scripts/vercel-env.ts"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
