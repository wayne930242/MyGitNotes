{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "docs/agent/**"
    }
  },
  "rewrites": [
    {
      "source": "/mcp/:routePath*",
      "destination": "/api"
    },
    {
      "source": "/api/:routePath*",
      "destination": "/api"
    },
    {
      "source": "/r2-assets/:routePath*",
      "destination": "/api"
    },
    {
      "source": "/raw-assets/:routePath*",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "core": true,
      "main": false
    }
  }
}
